msgstr "Catat pesan debug dan pesan normal."

#: src/prefs.js:301
msgid "Animation"
msgstr "Animasi"

#: src/prefs.js:306 src/prefs.js:319 src/prefs.js:434
msgid "Properties"
msgstr "Properti"

#: src/prefs.js:309
msgid "Easing Function"
msgstr "Fungsi easing"

#: src/prefs.js:309
msgid "Determine how windows move."
msgstr "Menentukan bagaimana jendela bergerak."

#: src/prefs.js:310
msgid "Duration [s]"
msgstr "Durasi [s]"

#: src/prefs.js:311
msgid "Randomize Durations"
msgstr "Acak durasi"

#: src/prefs.js:311
msgid ""
"Each animation duration assigned randomly between 0 and configured duration."
msgstr ""
"Setiap durasi animasi ditetapkan secara acak antara 0 dan durasi yang "
"dikonfigurasi."

#: src/prefs.js:314
msgid "Icons"
msgstr "Ikon"

#: src/prefs.js:323
msgid "Overlay Icon Size"
msgstr "Ukuran ikon overlay"

#: src/prefs.js:323
msgid "Set the overlay icon size in pixels."
msgstr "Atur ukuran ikon overlay dalam piksel."

#: src/prefs.js:324
msgid "Overlay Icon Opacity"
msgstr "Opasitas ikon overlay"

#: src/prefs.js:324
msgid "Set the overlay icon opacity."
msgstr "Atur opasitas ikon overlay."

#: src/prefs.js:328
msgid "Classic"
msgstr "Klasik"

#: src/prefs.js:334
msgid "Overlay"
msgstr "Overlay"

#: src/prefs.js:340
msgid "Attached"
msgstr "Terlampir"

#: src/prefs.js:345
msgid "Application Icon Style"
msgstr "Gaya ikon aplikasi"

#: src/prefs.js:350
msgid "Fade Only"
msgstr "Hanya pudar"

#: src/prefs.js:356
msgid "Scale Only"
msgstr "Hanya skala"

#: src/prefs.js:362
msgid "Fade and Scale"
msgstr "Pudar dan skala"

#: src/prefs.js:367
msgid "Add / Remove Effects"
msgstr "Tambah / Hapus Efek"

#: src/prefs.js:367
msgid "How Icons and Labels ease in and out."
msgstr "Bagaimana ikon dan label melakukan easing saat masuk dan keluar."

#: src/prefs.js:371
msgid "Icon Shadow"
msgstr "Bayangan Ikon"

#: src/prefs.js:375
msgid "Windows"
msgstr "Jendela"

#: src/prefs.js:379
msgid "General Settings"
msgstr "Pengaturan Umum"

#: src/prefs.js:382
msgid "Timeline Settings"
msgstr "Pengaturan Linimasa"

#: src/prefs.js:385
msgid "Coverflow Settings"
msgstr "Pengaturan Coverflow"

#: src/prefs.js:390
msgid "Window Size to Monitor Size Ratio"
msgstr "Rasio Ukuran Jendela terhadap Ukuran Monitor"

#: src/prefs.js:390
msgid "Maximum ratio of window size to monitor size."
msgstr "Rasio maksimum ukuran jendela terhadap ukuran monitor."

#: src/prefs.js:392
msgid "Current workspace only"
msgstr "Ruang kerja saat ini"

#: src/prefs.js:394
msgid "All workspaces"
msgstr "Semua ruang kerja"

#: src/prefs.js:396
msgid "All workspaces, current first"
msgstr "Semua ruang kerja, yang saat ini terlebih dahulu"

#: src/prefs.js:398
msgid "Workspaces"
msgstr "Ruang kerja"

#: src/prefs.js:398
msgid "Switch between windows on current or on all workspaces."
msgstr ""
"Beralih antarjendela di ruang kerja saat ini atau di semua ruang kerja."

#: src/prefs.js:402
msgid "Current Monitor"
msgstr "Monitor Saat Ini"

#: src/prefs.js:403
msgid "Switch between windows on current monitor."
msgstr "Beralih antarjendela di monitor saat ini."

#: src/prefs.js:415
msgid "Leave Other Monitors Unaffected"
msgstr ""

#: src/prefs.js:416
msgid ""
"Limit previews, hidden windows, and background effects to the current "
"monitor."
msgstr ""

#: src/prefs.js:418
msgid "Skip Minimized Windows"
msgstr "Lewati Jendela yang Diminimalkan"

#: src/prefs.js:418
msgid "Exclude minimized windows from the switcher."
msgstr "Keluarkan jendela yang diminimalkan dari switcher."

#: src/prefs.js:420
msgid "Window Layout Distance"
msgstr "Jarak Tata Letak Jendela"

#: src/prefs.js:420
msgid "Distance in pixels between timeline window's upper left corners."
msgstr "Jarak dalam piksel antara sudut kiri atas jendela linimasa."

#: src/prefs.js:421
msgid "Window Layout Angle"
msgstr "Sudut Tata Letak Jendela"

#: src/prefs.js:421
msgid ""
"Angle in degrees (0-90) for timeline window layout such that windows go from "
"lower right to upper left at this angle between successive window's upper "
"left corners. The topmost window's upper left corner is at the center of the "
"monitor."
msgstr ""
"Sudut dalam derajat (0–90) untuk tata letak jendela linimasa sehingga "
"jendela bergerak dari kanan bawah ke kiri atas dengan sudut ini di antara "
"sudut kiri atas jendela yang berurutan. Sudut kiri atas jendela teratas "
"berada di tengah monitor."

#: src/prefs.js:422
msgid "Window Tilt Angle"
msgstr "Sudut Kemiringan Jendela"

#: src/prefs.js:422
msgid "Y-axis rotation angle in degrees applied to timeline windows."
msgstr ""
"Sudut rotasi sumbu Y dalam derajat yang diterapkan pada jendela linimasa."

#: src/prefs.js:423 src/prefs.js:426
msgid "Window Scaling Factor"
msgstr "Faktor Skala Jendela"

#: src/prefs.js:423
msgid ""
"Factor by which timeline windows successively shrink with distance from the "
"top window."
msgstr ""
"Faktor yang membuat jendela linimasa secara berturut-turut mengecil seiring "
"jarak dari jendela teratas."

#: src/prefs.js:424
msgid "Enable Window Scaling"
msgstr "Aktifkan Skala Jendela"

#: src/prefs.js:424
msgid "Useful if you have a large number of windows and want to see them all."
msgstr "Berguna jika Anda memiliki banyak jendela dan ingin melihat semuanya."

#: src/prefs.js:426
msgid "Factor by which coverflow windows successively shrink off to the side."
msgstr ""
"Faktor yang membuat jendela coverflow secara berturut-turut mengecil ke "
"samping."

#: src/prefs.js:427
msgid "Window Angle"
msgstr "Sudut Jendela"

#: src/prefs.js:427
msgid "Angle of off-center windows in coverflow mode."
msgstr "Sudut jendela di luar pusat dalam mode coverflow."

#: src/prefs.js:428
msgid "Window Offset Width"
msgstr "Lebar Offset Jendela"

#: src/prefs.js:428
msgid "How far windows are off to the side in coverflow mode."
msgstr "Seberapa jauh jendela bergeser ke samping dalam mode coverflow."

#: src/prefs.js:430
msgid "AppSwitcher"
msgstr "AppSwitcher"

#: src/prefs.js:437
msgid "Make the Application Switcher Show Only First Preview"
msgstr "Buat Application Switcher hanya menampilkan pratinjau pertama"

#: src/prefs.js:437
msgid "Don't group windows of the same application in a subswitcher."
msgstr "Jangan kelompokkan jendela dari aplikasi yang sama dalam subswitcher."

#: src/prefs.js:438
msgid "Desaturate"
msgstr "Desaturasi"

#: src/prefs.js:438
msgid "Larger means more desaturation."
msgstr "Semakin besar nilainya, semakin tinggi desaturasinya."

#: src/prefs.js:441
msgid "Tint"
msgstr "Tint"

#: src/prefs.js:453 src/prefs.js:580
msgid "Color"
msgstr "Warna"

#: src/prefs.js:474 src/prefs.js:604
msgid "Set to Theme Color"
msgstr "Ubah ke Warna Tema"

#: src/prefs.js:539
msgid "Blend"
msgstr "Campur"

#: src/prefs.js:539
msgid "How much to blend the tint color; bigger means more tint color."
msgstr ""
"Seberapa banyak warna tint dicampurkan; semakin besar nilainya, semakin kuat "
"warna tint."

#: src/prefs.js:540
msgid "Glitch"
msgstr "Glitch"

#: src/prefs.js:543
msgid "Keybindings"
msgstr "Ikatan tombol"

#: src/prefs.js:548
msgid "System Actions Keybindings"
msgstr "Ikatan tombol tindakan sistem"

#: src/prefs.js:549
msgid ""
"In case of conflicts with other window switchers, can unbind from system "
"actions."
msgstr ""
"Jika terjadi konflik dengan window switcher lain, ikatan dapat dilepas dari "
"tindakan sistem."

#: src/prefs.js:552
msgid "Bind to 'switch-windows'"
msgstr "Ikat ke 'switch-windows'"

#: src/prefs.js:553
msgid "Bind to 'switch-applications'"
msgstr "Ikat ke 'switch-applications'"

#: src/prefs.js:556
msgid "Internal Actions Keybindings"
msgstr "Ikatan tombol tindakan internal"

#: src/prefs.js:557
msgid "Internal actions that will not conflict with other window switchers."
msgstr ""
"Tindakan internal yang tidak akan menimbulkan konflik dengan window switcher "
"lain."

#: src/prefs.js:560
msgid "Coverflow Switch Windows Shortcut"
msgstr "Shortcut Coverflow Switch Windows"

#: src/prefs.js:560
msgid "Activate window switcher."
msgstr "Aktifkan switcher jendela."

#: src/prefs.js:561
msgid "Coverflow Switch Windows That are Visible on All Workspaces Shortcut"
msgstr ""
"Pintasan Coverflow untuk Beralih Jendela yang Terlihat di Semua Workspace"

#: src/prefs.js:561
msgid "Activate window switcher listing windows visible on all workspaces."
msgstr ""
"Aktifkan switcher jendela yang menampilkan jendela terlihat di semua "
"workspace."

#: src/prefs.js:562
msgid "Coverflow Switch Applications Shortcut"
msgstr "Shortcut Coverflow Switch Applications"

#: src/prefs.js:562
msgid "Activate application switcher."
msgstr "Aktifkan switcher aplikasi."

#: src/prefs.js:563
msgid ""
"Coverflow Switch Applications That are Visible on All Workspaces Shortcut"
msgstr ""
"Pintasan Coverflow untuk Beralih Aplikasi yang Terlihat di Semua Workspace"

#: src/prefs.js:563
msgid ""
"Activate application switcher listing applications visible on all workspaces."
msgstr ""
"Aktifkan switcher aplikasi yang menampilkan aplikasi terlihat di semua "
"workspace."

#: src/prefs.js:567
msgid "Highlight Window Under Mouse"
msgstr "Sorot jendela di bawah mouse"

#: src/prefs.js:568
msgid ""
"Draw a colored highlight on window under the mouse to know the effects of "
"clicking."
msgstr ""
"Gambar sorotan berwarna pada jendela di bawah mouse agar efek klik dapat "
"diketahui."

#: src/prefs.js:666
msgid "Raise Window Under Mouse"
msgstr "Naikkan jendela di bawah mouse"

#: src/prefs.js:666
msgid "Raise the window under the mouse above all others."
msgstr "Naikkan jendela di bawah mouse ke atas semua jendela lainnya."

