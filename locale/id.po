#: src/prefs.js:176
msgid "Place window title above or below the switcher."
msgstr "Letakkan judul jendela di atas atau di bawah sakelar."

#: src/prefs.js:177
msgid "Enforce Primary Monitor"
msgstr "Terapkan Pengawas Utama"

#: src/prefs.js:177
msgid ""
"Always show on the primary monitor, otherwise, show on the active monitor."
msgstr ""
"Selalu tampilkan di monitor utama, jika tidak, tampilkan di monitor yang "
"aktif."

#: src/prefs.js:179
msgid "Hide Panel"
msgstr "Sembunyikan Panel"

#: src/prefs.js:179
msgid "Hide panel when switching windows."
msgstr "Sembunyikan panel saat beralih jendela."

#: src/prefs.js:180
msgid "Background Dim-Factor"
msgstr "Faktor Redup Latar Belakang"

#: src/prefs.js:180
msgid "Bigger means darker."
msgstr "Lebih besar berarti lebih gelap."

#: src/prefs.js:181
msgid "Invert Swipes"
msgstr "Balikkan Geseran"

#: src/prefs.js:181
msgid "Invert system scroll direction setting."
msgstr "Balikkan pengaturan arah gulir sistem."

#: src/prefs.js:182
msgid "Start with Next"
msgstr "Mulai dengan Berikutnya"

#: src/prefs.js:182
msgid "Start with the next window (instead of the current window)."
msgstr "Mulai dengan jendela berikutnya (bukan jendela saat ini)."

#: src/prefs.js:186
msgid "Dash to Dock Properties"
msgstr "Properti Dash to Dock"

#: src/prefs.js:191
msgid "Show"
msgstr "Tampilkan"

#: src/prefs.js:195
msgid "Hide"
msgstr "Sembunyikan"

#: src/prefs.js:199
