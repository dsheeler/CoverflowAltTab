msgid "Enforce Primary Monitor"
msgstr "­强制主显示器"

#: src/prefs.js:177
msgid ""
"Always show on the primary monitor, otherwise, show on the active monitor."
msgstr "始终在主显示器上显示切换器，否则在活动显示器上显示。"

#: src/prefs.js:179
msgid "Hide Panel"
msgstr "隐藏面板"

#: src/prefs.js:179
msgid "Hide panel when switching windows."
msgstr "切换窗口时隐藏面板。"

#: src/prefs.js:180
msgid "Background Dim-Factor"
msgstr "背景变暗系数"

#: src/prefs.js:180
msgid "Bigger means darker."
msgstr "越大越暗。"

#: src/prefs.js:181
msgid "Invert Swipes"
msgstr "反向滑动"

#: src/prefs.js:181
msgid "Invert system scroll direction setting."
msgstr "反转系统滚动方向设置。"

#: src/prefs.js:182
msgid "Start with Next"
msgstr "从下一个开始"

#: src/prefs.js:182
msgid "Start with the next window (instead of the current window)."
msgstr "从下一个窗口开始（而不是当前窗口）。"

#: src/prefs.js:186
msgid "Dash to Dock Properties"
msgstr "Dash to Dock 设置"

#: src/prefs.js:191
msgid "Show"
msgstr "显示"

#: src/prefs.js:195
msgid "Hide"
msgstr "隐藏"

#: src/prefs.js:199
