msgstr "属性"

#: src/prefs.js:309
msgid "Easing Function"
msgstr "缓动函数"

#: src/prefs.js:309
msgid "Determine how windows move."
msgstr "确定窗户如何移动。"

#: src/prefs.js:310
msgid "Duration [s]"
msgstr "时长 [秒]"

#: src/prefs.js:311
msgid "Randomize Durations"
msgstr "随机时长"

#: src/prefs.js:311
msgid ""
"Each animation duration assigned randomly between 0 and configured duration."
msgstr "动画时长为 0 到配置值之间的随机值。"

#: src/prefs.js:314
msgid "Icons"
msgstr "图标"

#: src/prefs.js:323
msgid "Overlay Icon Size"
msgstr "叠加图标大小"

#: src/prefs.js:323
msgid "Set the overlay icon size in pixels."
msgstr "设置叠加图标大小，以像素为单位。"

#: src/prefs.js:324
msgid "Overlay Icon Opacity"
msgstr "叠加图标透明度"

#: src/prefs.js:324
msgid "Set the overlay icon opacity."
msgstr "设置叠加图标透明度。"

#: src/prefs.js:328
msgid "Classic"
msgstr "经典"

#: src/prefs.js:334
msgid "Overlay"
msgstr "叠加"

#: src/prefs.js:340
msgid "Attached"
msgstr "已吸附"

#: src/prefs.js:345
msgid "Application Icon Style"
msgstr "应用图标风格"

#: src/prefs.js:350
msgid "Fade Only"
msgstr "仅淡出"

#: src/prefs.js:356
msgid "Scale Only"
msgstr "仅缩放"

#: src/prefs.js:362
msgid "Fade and Scale"
msgstr "淡入淡出与缩放"

#: src/prefs.js:367
msgid "Add / Remove Effects"
msgstr "添加 / 移除效果"

#: src/prefs.js:367
msgid "How Icons and Labels ease in and out."
msgstr "图标和标签如何淡入淡出。"

#: src/prefs.js:371
msgid "Icon Shadow"
msgstr "图标阴影"

#: src/prefs.js:375
msgid "Windows"
msgstr "窗口"

#: src/prefs.js:379
msgid "General Settings"
msgstr "一般设置"

#: src/prefs.js:382
msgid "Timeline Settings"
msgstr "时间轴设置"

#: src/prefs.js:385
msgid "Coverflow Settings"
msgstr "Coverflow设置"

#: src/prefs.js:390
msgid "Window Size to Monitor Size Ratio"
msgstr "窗口大小与屏幕大小的比例"

#: src/prefs.js:390
msgid "Maximum ratio of window size to monitor size."
msgstr "窗口大小与显示器大小的最大比例。"

#: src/prefs.js:392
msgid "Current workspace only"
msgstr "仅当前工作区"

#: src/prefs.js:394
msgid "All workspaces"
msgstr "所有工作区"

#: src/prefs.js:396
msgid "All workspaces, current first"
msgstr "所有工作区，当前为第一个"

#: src/prefs.js:398
msgid "Workspaces"
msgstr "工作区"

#: src/prefs.js:398
msgid "Switch between windows on current or on all workspaces."
msgstr "在当前或所有工作区的窗口间切换。"

#: src/prefs.js:399
msgid "Current Monitor"
msgstr "当前显示器"

#: src/prefs.js:399
msgid "Switch between windows on current monitor."
msgstr "在当前显示器的窗口间切换。"

#: src/prefs.js:400
msgid "Skip Minimized Windows"
msgstr "跳过最小化的窗口"

#: src/prefs.js:400
msgid "Exclude minimized windows from the switcher."
msgstr "从切换器中排除最小化的窗口。"

#: src/prefs.js:402
msgid "Window Layout Distance"
msgstr "窗口布局间距"

#: src/prefs.js:402
msgid "Distance in pixels between timeline window's upper left corners."
msgstr "时间轴窗口左上角之间的像素距离。"

#: src/prefs.js:403
msgid "Window Layout Angle"
msgstr "窗口布局角度"

#: src/prefs.js:403
msgid ""
"Angle in degrees (0-90) for timeline window layout such that windows go from "
"lower right to upper left at this angle between successive window's upper "
"left corners. The topmost window's upper left corner is at the center of the "
"monitor."
msgstr ""
"用于时间线窗口布局的角度（0-90度），使窗口按照该角度从右下角向左上角排列，角"
"度计算方式为连续窗口左上角之间的夹角。最上方窗口的左上角位于显示器中心。"

#: src/prefs.js:404
msgid "Window Tilt Angle"
msgstr "窗户倾斜角度"

#: src/prefs.js:404
msgid "Y-axis rotation angle in degrees applied to timeline windows."
msgstr "应用于时间轴窗口的 Y 轴旋转角度（以度为单位）。"

#: src/prefs.js:405 src/prefs.js:408
msgid "Window Scaling Factor"
msgstr "窗口缩放因子"

#: src/prefs.js:405
msgid ""
"Factor by which timeline windows successively shrink with distance from the "
"top window."
msgstr "时间线窗口随距离顶部窗口的增加而依次缩小的因子。"

#: src/prefs.js:406
msgid "Enable Window Scaling"
msgstr "启用窗口缩放"

#: src/prefs.js:406
msgid "Useful if you have a large number of windows and want to see them all."
msgstr "如果您有大量窗口并希望同时查看它们，这将非常有用。"

#: src/prefs.js:408
msgid "Factor by which coverflow windows successively shrink off to the side."
msgstr "CoverFlow窗口向侧边依次缩小的比例因子。"

#: src/prefs.js:409
msgid "Window Angle"
msgstr "窗口角度"

#: src/prefs.js:409
msgid "Angle of off-center windows in coverflow mode."
msgstr "封面流模式下偏中心窗口的角度。"

#: src/prefs.js:410
msgid "Window Offset Width"
msgstr "窗口偏移宽度"

#: src/prefs.js:410
msgid "How far windows are off to the side in coverflow mode."
msgstr "在CoverFlow模式下，窗口偏离侧边的距离。"

#: src/prefs.js:412
msgid "AppSwitcher"
msgstr "应用切换器"

#: src/prefs.js:419
msgid "Make the Application Switcher Show Only First Preview"
msgstr "让应用切换器只显示第一个预览"

#: src/prefs.js:419
msgid "Don't group windows of the same application in a subswitcher."
msgstr "不要将同一应用的窗口另分一组，并使用子切换器。"

#: src/prefs.js:420
msgid "Desaturate"
msgstr "去饱和"

#: src/prefs.js:420
msgid "Larger means more desaturation."
msgstr "数值越大，去饱和程度越大。"

#: src/prefs.js:423
msgid "Tint"
msgstr "上色"

#: src/prefs.js:435 src/prefs.js:562
msgid "Color"
msgstr "颜色"

#: src/prefs.js:456 src/prefs.js:586
msgid "Set to Theme Color"
msgstr "设置为主题色"

#: src/prefs.js:521
msgid "Blend"
msgstr "混合"

#: src/prefs.js:521
msgid "How much to blend the tint color; bigger means more tint color."
msgstr "颜色的混合量；数值越大，混合颜色越多。"

#: src/prefs.js:522
msgid "Glitch"
msgstr "故障"

#: src/prefs.js:525
msgid "Keybindings"
msgstr "按键绑定"

#: src/prefs.js:530
msgid "System Actions Keybindings"
msgstr "系统操作按键绑定"

#: src/prefs.js:531
msgid ""
"In case of conflicts with other window switchers, can unbind from system "
"actions."
msgstr "如果与其他窗口切换器发生冲突，可以解除绑定系统操作。"

#: src/prefs.js:534
msgid "Bind to 'switch-windows'"
msgstr "绑定到“switch-windows”"

#: src/prefs.js:535
msgid "Bind to 'switch-applications'"
msgstr "绑定到“switch-applications”"

#: src/prefs.js:538
msgid "Internal Actions Keybindings"
msgstr "内部操作按键绑定"

#: src/prefs.js:539
msgid "Internal actions that will not conflict with other window switchers."
msgstr "不会与其他窗口切换器冲突的内部操作。"

#: src/prefs.js:542
msgid "Coverflow Switch Windows Shortcut"
msgstr "Coverflow 切换窗口快捷键"

#: src/prefs.js:542
msgid "Activate window switcher."
msgstr "激活窗口切换器。"

#: src/prefs.js:543
msgid "Coverflow Switch Windows That are Visible on All Workspaces Shortcut"
msgstr "Coverflow 切换显示在所有工作区的窗口快捷键"

#: src/prefs.js:543
msgid "Activate window switcher listing windows visible on all workspaces."
msgstr "激活窗口切换器，列出在所有工作区可见的窗口。"

#: src/prefs.js:544
msgid "Coverflow Switch Applications Shortcut"
msgstr "Coverflow 切换应用快捷方式"

#: src/prefs.js:544
msgid "Activate application switcher."
msgstr "应用切换器。"

#: src/prefs.js:545
msgid ""
"Coverflow Switch Applications That are Visible on All Workspaces Shortcut"
msgstr "Coverflow 切换显示在所有工作区的应用程序的快捷方式"

#: src/prefs.js:545
msgid ""
"Activate application switcher listing applications visible on all workspaces."
msgstr "激活应用程序切换器，列出在所有工作区可见的应用程序。"

#: src/prefs.js:549
msgid "Highlight Window Under Mouse"
msgstr "高亮鼠标下窗口"

#: src/prefs.js:550
msgid ""
"Draw a colored highlight on window under the mouse to know the effects of "
"clicking."
msgstr "在鼠标悬停的窗口上绘制彩色高亮，以便了解点击将会产生的效果。"

#: src/prefs.js:648
msgid "Raise Window Under Mouse"
msgstr "提升鼠标下窗口"

#: src/prefs.js:648
msgid "Raise the window under the mouse above all others."
msgstr "将鼠标下窗口提升到其他窗口上层。"

